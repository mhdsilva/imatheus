{
  "name": "vale-do-matheus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "dev": "npm run assets && vite --host 0.0.0.0",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "format": "prettier --write index.html src scripts tests README.md PLANO.md"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.0",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
